<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Smart Chess</string>

    <!--
      Spoken announcement of the opponent's move.

      These are the one part of the app whose wording must be a resource rather than a literal:
      they are read out loud, so the voice has to be set to the language they are written in.
      announce_locale is that language, and it belongs beside them - the system language is not a
      reliable answer, because a locale the app has no translation for falls back to these
      defaults and would then be read aloud with the wrong pronunciation.

      Placeholders are positional so a translation can reorder them.
    -->
    <string name="announce_locale" translatable="false">en</string>

    <!-- Piece, destination square. -->
    <string name="announce_move">%1$s to %2$s</string>
    <!-- Piece, origin square, destination square. Used when the move needs disambiguating. -->
    <string name="announce_move_from">%1$s on %2$s to %3$s</string>
    <!-- Piece, destination square. -->
    <string name="announce_capture">%1$s captures on %2$s</string>
    <!-- Piece, origin square, destination square. -->
    <string name="announce_capture_from">%1$s on %2$s captures on %3$s</string>
    <string name="announce_castle_kingside">Castles kingside</string>
    <string name="announce_castle_queenside">Castles queenside</string>
    <!-- The move announced so far. Warns that a pawn leaves the board from an unnamed square. -->
    <string name="announce_en_passant">%1$s, en passant</string>
    <!-- The move announced so far, the piece promoted to. -->
    <string name="announce_promotion">%1$s, promoting to a %2$s</string>
    <!-- The move announced so far. -->
    <string name="announce_check">%1$s, check</string>
    <!-- The move announced so far. -->
    <string name="announce_checkmate">%1$s, checkmate</string>

    <string name="piece_pawn">Pawn</string>
    <string name="piece_knight">Knight</string>
    <string name="piece_bishop">Bishop</string>
    <string name="piece_rook">Rook</string>
    <string name="piece_queen">Queen</string>
    <string name="piece_king">King</string>

    <!-- How a game ended, shown at the end of a game and in the history. -->
    <string name="termination_checkmate">Checkmate</string>
    <string name="termination_stalemate">Stalemate</string>
    <string name="termination_resignation">Resignation</string>
    <string name="termination_timeout">Out of time</string>
    <string name="termination_aborted">Aborted</string>
    <string name="termination_unknown">Unknown</string>
    <string name="draw_agreement">Draw by agreement</string>
    <string name="draw_insufficient_material">Draw, insufficient material</string>
    <string name="draw_fifty_move_rule">Draw, fifty-move rule</string>
    <string name="draw_seventy_five_move_rule">Draw, 75-move rule</string>
    <string name="draw_threefold_repetition">Draw, threefold repetition</string>
    <string name="draw_fivefold_repetition">Draw, fivefold repetition</string>
    <string name="draw_unspecified">Draw</string>

    <string name="color_white">White</string>
    <string name="color_black">Black</string>
    <string name="draw_offer_opponent">Your opponent</string>

    <!--
      Messages the orchestrator reports as codes. The app chooses the words; the module that
      raised them cannot know what language the player reads.
    -->
    <string name="msg_board_unchanged">The board has not changed. Move a piece, then tap again.</string>
    <string name="msg_no_legal_move_matches">The board does not match any legal move.</string>
    <string name="msg_engine_capabilities_unavailable">Could not read the engine\'s capabilities.</string>
    <string name="msg_remote_capabilities_unavailable">Could not read the platform\'s capabilities.</string>
    <string name="msg_draw_not_supported">The engine does not take draw offers.</string>
    <string name="msg_board_failed">Board error.</string>
    <string name="msg_board_read_failed">Could not read the board.</string>
    <string name="msg_board_capabilities_unavailable">Could not read the board.</string>
    <string name="msg_engine_configuration_failed">The engine would not take those settings.</string>
    <string name="msg_remote_configuration_failed">The platform would not take those settings.</string>
    <string name="msg_seek_failed">Could not look for an opponent.</string>
    <string name="msg_move_rejected">That move was rejected.</string>
    <string name="msg_opponent_move_rejected">The opponent\'s move was rejected.</string>
    <string name="msg_engine_move_rejected">The engine\'s move was rejected.</string>
    <string name="msg_move_not_sent">Your move could not be sent to the server.</string>
    <string name="msg_engine_failed">Engine error.</string>
    <string name="msg_remote_failed">Remote error.</string>
    <string name="msg_game_creation_failed">The game could not be started.</string>
    <string name="msg_unexpected_failure">Something went wrong.</string>
    <!-- The message, and the failing module's error code for a bug report. -->
    <string name="msg_with_detail">%1$s (%2$s)</string>
    <!-- One square the board could not read. -->
    <string name="msg_unreadable_square">Could not read square %1$s. Re-seat the piece and try again.</string>
    <!-- A short list of squares. -->
    <string name="msg_unreadable_squares">Could not read squares %1$s. Re-seat the pieces and try again.</string>
    <!-- How many squares in total, then the first few. -->
    <string name="msg_unreadable_squares_truncated">Could not read %1$d squares, including %2$s. Re-seat the pieces and try again.</string>
</resources>
