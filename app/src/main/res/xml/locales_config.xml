<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages the app ships. Android 13 and later read this to offer the app in its own entry
  under Settings > Apps > Language, so the in-app picker and the system one stay in agreement.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="es" />
</locale-config>
