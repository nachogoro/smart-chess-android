<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.

  The app talks to Lichess over HTTPS and carries an API token, so cleartext is blocked by
  default - and correctly stays blocked in release builds, which never see this file.

  Instrumented tests exercise the HTTP layer against a MockWebServer on localhost, which speaks
  plain HTTP. The exemption is therefore limited to loopback: any other host is still refused,
  even in a debug build.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
